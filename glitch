<!DOCTYPE html><html lang="pt-BR"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Glitch - Portal do Povo</title>
<style>body{margin:0;background:#0a0a0a;color:#fff;font-family:Arial;padding:10px;text-align:center}
.box{background:#151515;border:1px solid #333;border-radius:14px;padding:12px}
input,textarea{width:100%;background:#222;border:1px solid #444;color:#fff;padding:12px;border-radius:10px;margin:5px 0;box-sizing:border-box}
.btn{border:none;width:100%;padding:14px;border-radius:10px;font-weight:bold;margin:5px 0}.btn-pink{background:#ff00ff;color:#fff}.btn-yellow{background:#ffcc00;color:#000}
canvas{width:100%;max-width:400px;border-radius:12px;border:2px solid #333;margin-top:10px}
a.voltar{color:#ffcc00;text-decoration:none;float:left}</style></head><body>
<a class="voltar" href="index.html">← Portal</a><h2 style="color:#ff00ff">✨ GERADOR GLITCH</h2>
<div class="box"><input type="file" id="foto" accept="image/*"><textarea id="msg" placeholder="Sua mensagem..."></textarea><label>Intensidade: <input type="range" id="intens" min="0" max="50" value="18"></label><button class="btn btn-pink" onclick="gerar()">GERAR EFEITO</button><button class="btn btn-yellow" onclick="baixar()">💾 BAIXAR</button><canvas id="c"></canvas></div>
<script>let img=null;foto.onchange=e=>{let f=e.target.files[0];let r=new FileReader();r.onload=ev=>{img=new Image();img.onload=()=>gerar();img.src=ev.target.result};r.readAsDataURL(f)}
function gerar(){if(!img)return alert('Escolhe foto');let can=c,ctx=can.getContext('2d'),int=parseInt(intens.value);can.width=img.width;can.height=img.height;ctx.clearRect(0,0,can.width,can.height);ctx.globalCompositeOperation='screen';ctx.globalAlpha=0.8;ctx.drawImage(img,-int,0);ctx.drawImage(img,int,0);ctx.globalAlpha=1;ctx.globalCompositeOperation='source-over';ctx.drawImage(img,0,0);for(let i=0;i<can.height;i+=10){if(Math.random()>0.8){ctx.fillStyle=`rgba(${255*Math.random()},${255*Math.random()},${255*Math.random()},0.2)`;ctx.fillRect(0,i,can.width,3)}}if(msg.value){ctx.fillStyle='#fff';ctx.strokeStyle='#000';ctx.lineWidth=6;ctx.font='bold '+(can.width/18)+'px Arial';ctx.textAlign='center';ctx.strokeText(msg.value,can.width/2,can.height-30);ctx.fillText(msg.value,can.width/2,can.height-30)}}
function baixar(){let a=document.createElement('a');a.download='glitch.png';a.href=c.toDataURL();a.click()}</script></body></html>
