<!DOCTYPE html><html lang="pt-br"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Tesoura Corta Músicas</title>
<style>body{background:#000;color:#fff;font-family:Arial;padding:15px;text-align:center}input,button{width:100%;padding:12px;margin:6px 0;border-radius:8px;border:none}button{background:#FFD700;color:#000;font-weight:900}.voltar{background:#111;color:#FFD700;border:1px solid #FFD700}a{color:#FFD700}</style></head>
<body><h2 style="color:#FFD700">✂️ TESOURA CORTA MÚSICAS</h2><input type="file" id="audio" accept="audio/*"><audio id="player" controls style="width:100%;margin-top:10px"></audio><div style="display:flex;gap:5px"><input id="ini" type="number" placeholder="Início (seg)"><input id="fim" type="number" placeholder="Fim (seg)"></div><button onclick="cortar()">✂️ CORTAR E BAIXAR</button><button onclick="backup()" style="background:#222;color:#fff">💾 BACKUP</button><br><br><a href="index.html"><button class="voltar">◀️ Voltar pro Portal do Povo</button></a>
<script>
let audioBlob;document.getElementById('audio').onchange=e=>{let f=e.target.files[0];audioBlob=f;document.getElementById('player').src=URL.createObjectURL(f)};
async function cortar(){if(!audioBlob)return alert('Adicione música');let ini=parseFloat(document.getElementById('ini').value)||0,fim=parseFloat(document.getElementById('fim').value);let ctx=new AudioContext();let buf=await ctx.decodeAudioData(await audioBlob.arrayBuffer());let iniS=Math.floor(ini*buf.sampleRate),fimS=fim?Math.floor(fim*buf.sampleRate):buf.length;let novo=ctx.createBuffer(buf.numberOfChannels,fimS-iniS,buf.sampleRate);for(let c=0;c<buf.numberOfChannels;c++){novo.copyToChannel(buf.getChannelData(c).slice(iniS,fimS),c)}let wav=audioBufferToWav(novo);let b=new Blob([wav],{type:'audio/wav'});let a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='corte_'+audioBlob.name+'.wav';a.click()}
function backup(){alert('Backup do corte: salve o arquivo original')}function audioBufferToWav(b){let l=b.length*2+44,v=new ArrayBuffer(l),d=new DataView(v);let w=(o,s)=>{for(let i=0;i<s.length;i++)d.setUint8(o+i,s.charCodeAt(i))};w(0,'RIFF');d.setUint32(4,l-8,true);w(8,'WAVE');w(12,'fmt ');d.setUint32(16,16,true);d.setUint16(20,1,true);d.setUint16(22,b.numberOfChannels,true);d.setUint32(24,b.sampleRate,true);d.setUint32(28,b.sampleRate*2,true);d.setUint16(32,2,true);d.setUint16(34,16,true);w(36,'data');d.setUint32(40,l-44,true);let o=44;for(let i=0;i<b.length;i++){for(let ch=0;ch<b.numberOfChannels;ch++){let s=Math.max(-1,Math.min(1,b.getChannelData(ch)[i]));d.setInt16(o,s<0?s*0x8000:s*0x7FFF,true);o+=2}}return v}
</script></body></html>
